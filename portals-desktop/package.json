{
  "name": "gods-portals-desktop",
  "version": "1.0.0",
  "description": "GODS Portals desktop application (G.O.D.S ecosystem)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "za.gods.portals.desktop",
    "productName": "GODS Portals",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "icon.png"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" }
}
