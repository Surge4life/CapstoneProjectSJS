[Unit]
Description=UDOC Platform Core (FastAPI governance backend)
Requires=udoc-selftest.service
After=udoc-selftest.service
# ConditionPathExists ensures we only start if the self-test gate is open.
ConditionPathExists=/run/udoc/selftest.json

[Service]
Type=simple
WorkingDirectory=/opt/udoc/platform-core
# Refuse to start unless gate_open==true (fail-closed enforced at the unit level too).
ExecStartPre=/usr/bin/python3 -c "import json,sys; sys.exit(0 if json.load(open('/run/udoc/selftest.json'))['gate_open'] else 1)"
ExecStart=/usr/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
