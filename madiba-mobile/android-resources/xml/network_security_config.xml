<?xml version="1.0" encoding="utf-8"?>
<!-- Allows the connect-screen to reach your deployed backend over LAN (http) or tunnel (https).
     For production-only HTTPS, set cleartextTrafficPermitted="false". -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
