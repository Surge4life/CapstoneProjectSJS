<?xml version="1.0" encoding="utf-8"?>
<!-- Production: all G.O.D.S surfaces are HTTPS on Render. No cleartext required. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
